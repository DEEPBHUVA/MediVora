{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "YOUR_CONNECTION_STRING",
        "Redis": "localhost:6379"
    },
    "JWT": {
        "key": "YOUR_LONG_RANDOM_SECRET_KEY",
        "Issuer": "SecureApi",
        "Audience": "SecureApiUser",
        "DurationInMinutes": 60
    },
    "RateLimiting": {
        "Global": {
            "PermitLimit": 1000,
            "WindowSeconds": 60
        },
        "Login": {
            "PermitLimit": 5,
            "WindowSeconds": 60
        },
        "Register": {
            "PermitLimit": 5,
            "WindowSeconds": 60
        },
        "DoctorSearch": {
            "PermitLimit": 60,
            "WindowSeconds": 60
        },
        "GeneralApi": {
            "PermitLimit": 100,
            "WindowSeconds": 60
        },
        "Appointment Booking": {
            "PermitLimit": 10,
            "WindowSeconds": 60
        },
        "SlidingApi": {
            "PermitLimit": 100,
            "WindowSeconds": 60,
            "SegmentsPerWindow": 6
        },
        "TokenBucket": {
            "TokenLimit": 20,
            "TokensPerPeriod": 10,
            "ReplenishmentPeriodSeconds": 30,
            "QueueLimit": 0
        },
        "ExpensiveOperation": {
            "PermitLimit": 5,
            "QueueLimit": 0
        }
    }
}